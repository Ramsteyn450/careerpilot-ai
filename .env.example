# CareerPilot AI Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot_ai

# Security & Authentication
JWT_SECRET=careerpilot_ai_super_secret_jwt_key_2026_change_in_production
JWT_REFRESH_SECRET=careerpilot_ai_refresh_jwt_key_2026_change_in_production

# AI Provider Configuration
# Supported providers: 'local' | 'gemini' | 'openai'
# If AI API key is not configured, CareerPilot AI uses its deterministic local AI fallback engine without failure.
AI_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage
MAX_FILE_SIZE_MB=10
